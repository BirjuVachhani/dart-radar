# Signing + notarization credentials for the Makefile. config.mk holds an Apple
# ID app-specific password, the .p12 export password and the R2 keys; secrets/
# holds the exported certificate private key itself. config.mk.example is the
# tracked template.
config.mk
secrets/

# The same credentials by file type, wherever they land. secrets/ above is the
# path the Makefile documents, but a certificate or profile exported to the
# repo root by accident is the one mistake worth catching twice.
*.p12
*.pfx
*.cer
*.certSigningRequest
*.provisionprofile
*.mobileprovision
.env
.env.*
!.env.example

# Build output: Xcode's derived data (DERIVED_DATA) and the Makefile's
# ARTIFACTS_DIR. artifacts/ also receives the notarized DMG and appcast.xml.
build/
artifacts/
*.dmg

# Xcode and SwiftPM leftovers from building or opening the project by hand,
# rather than through `make`.
DerivedData/
.build/
.swiftpm/
*.dSYM
*.dSYM.zip
*.hmap
*.ipa
*.moved-aside
*.xcuserstate
*.xccheckout
*.xcscmblueprint
*.xcresult

# Derived from project.yml by xcodegen. `make generate` rewrites both, so any
# edit made in Xcode's UI (or directly in the plist) is lost. Change project.yml
# instead: the Sparkle keys and the version placeholders all live there.
DartRadar.xcodeproj/
DartRadar/Info.plist
*.xcworkspace/xcuserdata/
xcuserdata/

# scripts/make-appcast.py
__pycache__/
*.py[cod]

# Editors
.vscode/
.idea/
*.swp
*~

# OS junk
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
